{
  "name": "model_nemotron_super",
  "group": "model",
  "default": false,
  "description": "OpenRouter free Nemotron 3 Super 120B-A12B, fallbacks disabled.",
  "env": {
    "GAIA_PROVIDER": "openrouter",
