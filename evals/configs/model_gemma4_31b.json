{
  "name": "model_gemma4_31b",
  "group": "model",
  "default": false,
  "description": "OpenRouter free Gemma 4 31B (text+image), fallbacks disabled so the number is this model's alone.",
  "env": {
    "GAIA_PROVIDER": "openrouter",
    "GAIA_MODEL_ID": "google/gemma-4-31b-it:free",
    "GAIA_VISION_MODEL_ID": "google/gemma-4-31b-it:free",
    "GAIA_FALLBACKS": ""
  },
  "requires": {
    "env": [
      "OPENROUTER_API_KEY"
    ]
  },
  "repeats": 1
}
